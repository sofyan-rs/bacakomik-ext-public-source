{
  // Typechecks extensions only (scripts/ run under Bun). lib has no DOM, so
  // URL/fetch/setTimeout are type errors here just like they fail in QuickJS.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": ["types/**/*.d.ts", "src/**/*.js"]
}
